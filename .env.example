# Required for GPT-4o structured extraction. Audio transcription is local stable-ts.
OPENAI_API_KEY=sk-...

# Node API -> Python Cognee service.
COGNEE_SERVICE_URL=http://localhost:8001

# Browser -> Hono API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Extra browser origins allowed to call the Hono API (comma-separated).
# Any localhost/127.0.0.1 origin on any port is always allowed for local dev.
# Set this for non-local deployments, e.g. https://anamnesis.example.com
CORS_ORIGINS=

# Models used by apps/api.
LLM_MODEL=gpt-4o

# Local stable-ts transcription model loaded by services/cognee.
STABLE_TS_MODEL=base
STABLE_TS_DEVICE=
STABLE_TS_DOWNLOAD_ROOT=
STABLE_TS_DYNAMIC_QUANTIZATION=false

# Optional local memory/Cognee projection storage for services/cognee.
ANAMNESIS_DATA_DIR=./services/cognee/.data
