# LLM provider for structured medical-entity extraction. Audio transcription is
# local stable-ts. Choose ONE of the following:
#
# 1) OpenAI GPT-4o (default):
# OPENAI_API_KEY=sk-...
#
# 2) Sakana Fugu (OpenAI-compatible). If SAKANA_API_KEY is set and OPENAI_API_KEY
#    is NOT, the API auto-targets https://api.sakana.ai/v1 with model "fugu".
# SAKANA_API_KEY=...
#
# 3) Any other OpenAI-compatible endpoint (explicit override, wins over the above):
# LLM_BASE_URL=https://api.sakana.ai/v1
# LLM_API_KEY=...
OPENAI_API_KEY=sk-...

# Node API -> Python Cognee service.
COGNEE_SERVICE_URL=http://localhost:8001

# Browser -> Hono API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Extra browser origins allowed to call the Hono API (comma-separated).
# Any localhost/127.0.0.1 origin on any port is always allowed for local dev.
# Set this for non-local deployments, e.g. https://anamnesis.example.com
CORS_ORIGINS=

# Model used by apps/api. Defaults to gpt-4o for OpenAI, or "fugu" when Sakana is
# auto-selected. For Fugu you can also use e.g. fugu-ultra.
# LLM_MODEL=fugu
LLM_MODEL=gpt-4o

# Optional: request timeout (ms) for the LLM call. Fugu Ultra can be slow.
# LLM_TIMEOUT_MS=180000

# Local stable-ts transcription model loaded by services/cognee.
STABLE_TS_MODEL=base
STABLE_TS_DEVICE=
STABLE_TS_DOWNLOAD_ROOT=
STABLE_TS_DYNAMIC_QUANTIZATION=false

# Optional local memory/Cognee projection storage for services/cognee.
ANAMNESIS_DATA_DIR=./services/cognee/.data
